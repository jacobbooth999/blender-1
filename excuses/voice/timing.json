{
 "duration": 31.409,
 "voice": "af_heart",
 "lines": [
  {
   "i": 0,
   "text": "Your excuses aren't protecting you. They're trapping you.",
   "start": 0.05,
   "end": 2.795
  },
  {
   "i": 1,
   "text": "Here's the truth nobody wants to hear.",
   "start": 2.945,
   "end": 4.743
  },
  {
   "i": 2,
   "text": "I'm too tired.",
   "start": 4.893,
   "end": 5.761
  },
  {
   "i": 3,
   "text": "I don't have time.",
   "start": 5.861,
   "end": 6.791
  },
  {
   "i": 4,
   "text": "I'll start on Monday.",
   "start": 6.891,
   "end": 7.883
  },
  {
   "i": 5,
   "text": "Every excuse sounds reasonable.",
   "start": 8.083,
   "end": 9.715
  },
  {
   "i": 6,
   "text": "That's exactly why it's dangerous.",
   "start": 9.815,
   "end": 11.613
  },
  {
   "i": 7,
   "text": "Every excuse is a promise you break to yourself.",
   "start": 11.863,
   "end": 14.283
  },
  {
   "i": 8,
   "text": "And the more you break them, the less you trust yourself.",
   "start": 14.403,
   "end": 16.931
  },
  {
   "i": 9,
   "text": "Meanwhile, someone with less time, less money, and more problems is doing it anyway.",
   "start": 17.181,
   "end": 21.498
  },
  {
   "i": 10,
   "text": "The difference isn't talent.",
   "start": 21.748,
   "end": 23.002
  },
  {
   "i": 11,
   "text": "They just stopped negotiating.",
   "start": 23.102,
   "end": 24.434
  },
  {
   "i": 12,
   "text": "So next time you hear an excuse, call it what it is.",
   "start": 24.684,
   "end": 27.253
  },
  {
   "i": 13,
   "text": "A choice.",
   "start": 27.373,
   "end": 28.04
  },
  {
   "i": 14,
   "text": "And you can choose differently, starting today.",
   "start": 28.34,
   "end": 30.426
  },
  {
   "i": 15,
   "text": "Because remember,",
   "start": 30.576,
   "end": 31.409
  }
 ]
}