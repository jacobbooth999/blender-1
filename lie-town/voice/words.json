 ],
 "phrases": [
  {
   "text": "In this town,",
   "start": 0.12,
   "end": 0.995,
   "voice": "am_michael"
  },
  {
   "text": "every time you lie,",
   "start": 1.075,
   "end": 2.183,
   "voice": "am_michael"
  },
  {
   "text": "you earn money.",
   "start": 2.243,
   "end": 3.109,
   "voice": "am_michael"
  },
  {
   "text": "Tell your teacher the dog ate your homework?",
   "start": 3.409,
   "end": 5.604,
   "voice": "am_michael"
  },
  {
   "text": "Five dollars.",
   "start": 5.724,
   "end": 6.653,
   "voice": "am_michael"
  },
  {
   "text": "Tell your wife you love her cooking?",
   "start": 6.933,
   "end": 8.627,
   "voice": "am_michael"
  },
  {
   "text": "Fifty.",
   "start": 8.747,
   "end": 9.343,
   "voice": "am_michael"
  },
  {
   "text": "The mayor lies so much, he lives in a golden mansion.",
   "start": 9.643,
   "end": 12.906,
   "voice": "am_michael"
  },
  {
   "text": "But Sam has never told a single lie.",
   "start": 13.306,
   "end": 15.497,
   "voice": "am_michael"
  },
  {
   "text": "Not once.",
   "start": 15.647,
   "end": 16.416,
   "voice": "am_michael"
  },
  {
   "text": "So Sam lives in a cardboard box behind the bakery.",
   "start": 16.716,
   "end": 19.906,
   "voice": "am_michael"
  },
  {
   "text": "He eats bread crusts for dinner, and everyone laughs at him.",
   "start": 20.156,
   "end": 23.368,
   "voice": "am_michael"
  },
  {
   "text": "Then one night, Sam saw a giant crack in the dam above the town.",
   "start": 23.818,
   "end": 27.449,
   "voice": "am_michael"
  },
  {
   "text": "He ran straight to the mayor.",
   "start": 27.699,
   "end": 29.051,
   "voice": "am_michael"
  },
  {
   "text": "But fixing it would cost the mayor his gold.",
   "start": 29.301,
   "end": 31.523,
   "voice": "am_michael"
  },
  {
   "text": "So he smiled, and wrote Sam a cheque for one million dollars.",
   "start": 31.773,
   "end": 35.091,
   "voice": "am_michael"
  },
  {
   "text": "Tell everyone the dam is safe.",
   "start": 35.391,
   "end": 37.583,
   "voice": "bm_george"
  },
  {
   "text": "One lie, and you'll never be poor again.",
   "start": 37.733,
   "end": 39.98,
   "voice": "bm_george"
  },
  {
   "text": "Sam looked at the cheque.",
   "start": 40.38,
   "end": 41.511,
   "voice": "am_michael"
  },
  {
   "text": "Then at his cardboard box.",
   "start": 41.711,
   "end": 43.303,
   "voice": "am_michael"
  },
  {
   "text": "The next morning, the whole town was watching.",
   "start": 43.803,
   "end": 46.21,
   "voice": "am_michael"
  },
  {
   "text": "Sam looked into the camera, and said,",
   "start": 46.46,
   "end": 48.24,
   "voice": "am_michael"
  },
  {
   "text": "The dam is breaking. Run to the hill. Now.",
   "start": 48.441,
   "end": 50.468,
   "voice": "am_adam"
  },
  {
   "text": "Nobody in town believed each other anymore.",
   "start": 50.918,
   "end": 53.69,
   "voice": "am_michael"
  },
  {
   "text": "But everyone knew one thing.",
   "start": 53.89,
   "end": 55.352,
   "voice": "am_michael"
  },
  {
   "text": "Sam never lies.",
   "start": 55.502,
   "end": 56.592,
   "voice": "am_michael"
  },
  {
   "text": "So they ran.",
   "start": 56.892,
   "end": 57.73,
   "voice": "am_michael"
  },
  {
   "text": "Minutes later, the dam burst.",
   "start": 58.08,
   "end": 59.753,
   "voice": "am_michael"
  },
  {
   "text": "The golden mansion washed away.",
   "start": 60.103,
   "end": 61.849,
   "voice": "am_michael"
  },
  {
   "text": "But every single person was safe.",
   "start": 61.999,
   "end": 63.771,
   "voice": "am_michael"
  },
  {
   "text": "The town built Sam a real house, with a statue out front.",
   "start": 64.221,
   "end": 67.747,
   "voice": "am_michael"
  },
  {
   "text": "He's still the poorest man in town.",
   "start": 68.047,
   "end": 69.873,
   "voice": "am_michael"
  },
  {
   "text": "But he's the only one everybody trusts.",
   "start": 70.073,
   "end": 72.361,
   "voice": "am_michael"
  }
 ]
}